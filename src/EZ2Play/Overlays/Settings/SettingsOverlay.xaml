
<UserControl x:Class="EZ2Play.App.SettingsOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:EZ2Play.App"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="{DynamicResource OverlayBackdropBrush}">

    <UserControl.Resources>

        <!-- Base transform for TextBlock elements. -->
        <Style TargetType="TextBlock">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary settings item label. -->
        <Style x:Key="SettingsItemLabelStyle"
            TargetType="TextBlock"
            BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin"
                Value="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayLabelMargin}}"/>
        </Style>

        <!-- Secondary description displayed below a settings label. -->
        <Style x:Key="SettingsItemDescriptionStyle"
            TargetType="TextBlock"
            BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground"
                Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="FontSize"
                Value="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayDescFontSize}}"/>
        </Style>

        <!-- Scaled container for WPF UI toggle switches. -->
        <Style x:Key="SettingsToggleViewboxStyle"
            TargetType="Viewbox">
            <Setter Property="Width"
                Value="{DynamicResource {x:Static app:UiScaleKeys.ToggleSwitchWidth}}"/>
            <Setter Property="Height"
                Value="{DynamicResource {x:Static app:UiScaleKeys.ToggleSwitchHeight}}"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- Label used by nested startup settings. -->
        <Style x:Key="SettingsTreeLabelStyle"
            TargetType="TextBlock"
            BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin"
                Value="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayLabelTreeMargin}}"/>
            <Setter Property="FontSize"
                Value="{DynamicResource {x:Static app:UiScaleKeys.OverlaySecondaryFontSize}}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Scaled container for nested setting checkboxes. -->
        <Style x:Key="SettingsCheckBoxViewboxStyle"
            TargetType="Viewbox">
            <Setter Property="Width"
                Value="{DynamicResource {x:Static app:UiScaleKeys.CheckBoxSize}}"/>
            <Setter Property="Height"
                Value="{DynamicResource {x:Static app:UiScaleKeys.CheckBoxSize}}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <!-- Main settings surface with a dithered gradient background. -->
    <app:DitheredGradientBorder x:Name="SettingsSurface"
        Style="{StaticResource OverlaySurfaceStyle}"
        Height="Auto">

        <Grid Margin="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="85*"/>
                <RowDefinition Height="15*"/>
            </Grid.RowDefinitions>

            <!-- Exit confirmation message. -->
            <TextBlock x:Name="ExitConfirmText"
                Grid.Row="0"
                Visibility="Collapsed"
                Style="{StaticResource OverlayPrimaryTextStyle}"
                HorizontalAlignment="Center"
                Margin="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayItemPadding}}"/>

            <!-- Main settings navigation list. -->
            <ListBox x:Name="SettingsListBox"
                Grid.Row="1"
                FontSize="{DynamicResource {x:Static app:UiScaleKeys.OverlayPrimaryFontSize}}"
                FontWeight="400"
                HorizontalContentAlignment="Stretch"
                VerticalAlignment="Center"
                Background="Transparent">

                <!-- Appearance of top-level settings items. -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding"
                            Value="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayItemPadding}}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>

                                        <Border x:Name="ItemBorder"
                                            Padding="{TemplateBinding Padding}"
                                            Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>

                                        <Border x:Name="ItemDivider"
                                            Style="{StaticResource AppDividerStyle}"
                                            VerticalAlignment="Bottom"
                                            Margin="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayDividerMargin}}"/>

                                    </Grid>

                                    <ControlTemplate.Triggers>

                                        <!-- Gradient background for nested settings. -->
                                        <Trigger Property="Tag"
                                            Value="TreeContainer">
                                            <Setter TargetName="ItemBorder"
                                                Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush
                                                        StartPoint="0,0"
                                                        EndPoint="0,1">
                                                        <GradientStop
                                                            Color="#00000000"
                                                            Offset="0"/>
                                                        <GradientStop
                                                            Color="#26000000"
                                                            Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <!-- Main autorun toggle and its description. -->
                <ListBoxItem x:Name="SettingsAutorunApp"
                    Tag="TreeHeader">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.05*"/>
                            <ColumnDefinition Width="0.80*"/>
                            <ColumnDefinition Width="0.10*"/>
                            <ColumnDefinition Width="0.05*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayLabelMargin}}">

                            <TextBlock x:Name="SettingsAutorunAppLabel"
                                Style="{StaticResource SettingsItemLabelStyle}"/>

                            <TextBlock x:Name="SettingsAutorunAppDesc"
                                Style="{StaticResource SettingsItemDescriptionStyle}"/>

                        </StackPanel>

                        <Viewbox Grid.Column="2"
                            Style="{StaticResource SettingsToggleViewboxStyle}">
                            <ui:ToggleSwitch x:Name="AutorunToggle"/>
                        </Viewbox>

                    </Grid>

                </ListBoxItem>

                <!-- Nested startup options displayed under the autorun setting. -->
                <ListBoxItem x:Name="TreeItemsContainer"
                    Background="Transparent"
                    Tag="TreeContainer"
                    Margin="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayTreeItemsContainerMargin}}"
                    Padding="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayTreeItemsContainerPadding}}">

                    <Grid>

                        <ListBox x:Name="SubOptionsListBox"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            Focusable="False">

                            <!-- Three equally sized startup options. -->
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" Rows="1"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <!-- Appearance of nested settings items. -->
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid>

                                                    <Border x:Name="ItemBorder"
                                                        Padding="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayTreeItemPadding}}"
                                                        Margin="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayTreeItemMargin}}"
                                                        CornerRadius="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayTreeItemRadius}}"
                                                        BorderBrush="Transparent"
                                                        Style="{StaticResource TreeItemStyle}">
                                                        <ContentPresenter/>
                                                    </Border>

                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <!-- Disable the startup splash screen. -->
                            <ListBoxItem x:Name="NoSplash"
                                Tag="TreeItem">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.10*"/>
                                        <ColumnDefinition Width="0.80*"/>
                                        <ColumnDefinition Width="0.05*"/>
                                        <ColumnDefinition Width="0.05*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="1"
                                        x:Name="SettingsTreeNoSplash"
                                        Style="{StaticResource SettingsTreeLabelStyle}"/>

                                    <Viewbox Grid.Column="2"
                                        Style="{StaticResource SettingsCheckBoxViewboxStyle}">
                                        <CheckBox x:Name="NoSplashToggle"/>
                                    </Viewbox>

                                </Grid>

                            </ListBoxItem>

                            <!-- Disable background music. -->
                            <ListBoxItem x:Name="NoMusic"
                                Tag="TreeItem">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.10*"/>
                                        <ColumnDefinition Width="0.80*"/>
                                        <ColumnDefinition Width="0.05*"/>
                                        <ColumnDefinition Width="0.05*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="1"
                                        x:Name="SettingsTreeNoMusic"
                                        Style="{StaticResource SettingsTreeLabelStyle}"/>

                                    <Viewbox Grid.Column="2"
                                        Style="{StaticResource SettingsCheckBoxViewboxStyle}">
                                        <CheckBox x:Name="NoMusicToggle"/>
                                    </Viewbox>

                                </Grid>

                            </ListBoxItem>

                            <!-- Enable automatic external display switching. -->
                            <ListBoxItem x:Name="HotSwap"
                                Tag="TreeItem">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.10*"/>
                                        <ColumnDefinition Width="0.80*"/>
                                        <ColumnDefinition Width="0.05*"/>
                                        <ColumnDefinition Width="0.05*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="1"
                                        x:Name="SettingsTreeHotSwap"
                                        Style="{StaticResource SettingsTreeLabelStyle}"/>

                                    <Viewbox Grid.Column="2"
                                        Style="{StaticResource SettingsCheckBoxViewboxStyle}">
                                        <CheckBox x:Name="HotSwapToggle"/>
                                    </Viewbox>

                                </Grid>

                            </ListBoxItem>

                        </ListBox>

                    </Grid>

                </ListBoxItem>

                <!-- FPS Monitor integration toggle. -->
                <ListBoxItem x:Name="SettingsFpsMonitor">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.05*"/>
                            <ColumnDefinition Width="0.80*"/>
                            <ColumnDefinition Width="0.10*"/>
                            <ColumnDefinition Width="0.05*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayLabelMargin}}">

                            <TextBlock x:Name="SettingsFpsMonitorLabel"
                                Style="{StaticResource SettingsItemLabelStyle}"/>

                            <TextBlock x:Name="SettingsFpsMonitorDesc"
                                Style="{StaticResource SettingsItemDescriptionStyle}"/>

                        </StackPanel>

                        <Viewbox Grid.Column="2"
                            Style="{StaticResource SettingsToggleViewboxStyle}">
                            <ui:ToggleSwitch x:Name="FpsMonitorToggle"/>
                        </Viewbox>

                    </Grid>

                </ListBoxItem>

                <!-- Display switching setting. -->
                <ListBoxItem x:Name="SettingsSourceDisplay">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.05*"/>
                            <ColumnDefinition Width="0.80*"/>
                            <ColumnDefinition Width="0.10*"/>
                            <ColumnDefinition Width="0.05*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayLabelMargin}}">

                            <TextBlock x:Name="SettingsSourceDisplayLabel"
                                Style="{StaticResource SettingsItemLabelStyle}"/>

                            <TextBlock x:Name="SettingsSourceDisplayDesc"
                                Style="{StaticResource SettingsItemDescriptionStyle}"/>

                        </StackPanel>

                        <!-- Display navigation glyph. -->
                        <TextBlock Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                            FontSize="{DynamicResource {x:Static app:UiScaleKeys.OverlaySecondaryFontSize}}"
                            FontFamily="{StaticResource IconFont}">&#xE306;</TextBlock>

                    </Grid>

                </ListBoxItem>

                <!-- Application exit action. -->
                <ListBoxItem x:Name="SettingsExitApp"
                    Tag="Last">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.05*"/>
                            <ColumnDefinition Width="0.90*"/>
                            <ColumnDefinition Width="0.05*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="1"
                            x:Name="SettingsExitAppLabel"
                            Margin="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayLabelTreeMargin}}"/>

                    </Grid>

                </ListBoxItem>

            </ListBox>

            <!-- Confirmation list is displayed instead of normal settings navigation. -->
            <Grid Grid.Row="1">

                <ListBox x:Name="ExitConfirmationListBox"
                    Visibility="Collapsed"
                    FontSize="{DynamicResource {x:Static app:UiScaleKeys.OverlayPrimaryFontSize}}"
                    FontWeight="600"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0">

                    <!-- Two horizontally arranged confirmation choices. -->
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" Rows="1"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding"
                                Value="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayItemPadding}}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid>
                                            <Border Padding="{TemplateBinding Padding}"
                                                Background="Transparent">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <!-- Confirm exit. -->
                    <ListBoxItem x:Name="ConfirmYesItem">
                        <TextBlock x:Name="ConfirmYes"
                            HorizontalAlignment="Center"/>
                    </ListBoxItem>

                    <!-- Cancel exit. -->
                    <ListBoxItem x:Name="ConfirmNoItem">
                        <TextBlock x:Name="ConfirmNo"
                            HorizontalAlignment="Center"/>
                    </ListBoxItem>

                </ListBox>

                <!-- Top divider -->
                <Border Style="{StaticResource AppDividerStyle}"
                    VerticalAlignment="Top"
                    Visibility="{Binding Visibility, ElementName=ExitConfirmationListBox}"
                    IsHitTestVisible="False"/>

                <!-- Bottom divider -->
                <Border Style="{StaticResource AppDividerStyle}"
                    VerticalAlignment="Bottom"
                    Visibility="{Binding Visibility, ElementName=ExitConfirmationListBox}"
                    IsHitTestVisible="False"/>

            </Grid>

            <!-- Application description and version. -->
            <TextBlock Grid.Row="2"
                FontSize="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayDescFontSize}}"
                Foreground="{DynamicResource TextFillColorDisabledBrush}"
                HorizontalAlignment="Center"
                Margin="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayAppInfoMargin}}">

                <Run Text="{x:Static app:AppInfo.Description}"/>
                <Run Text="v"/>
                <Run Text="{x:Static app:AppInfo.Version}"/>

            </TextBlock>

        </Grid>

    </app:DitheredGradientBorder>

</UserControl>
