
<UserControl x:Class="EZ2Play.App.ParserOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:EZ2Play.App"
    Background="Transparent">

    <UserControl.Resources>

        <!-- Item style for SteamGridDB game search results. -->
        <Style x:Key="ParserItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="{DynamicResource {x:Static app:UiScaleKeys.ParserGameItemHeight}}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Padding="{TemplateBinding Padding}"
                            Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Item style shared by cover and background previews. -->
        <Style x:Key="ParserCoverItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- Root layout for parser content and status overlays. -->
    <Grid>

        <!-- Main parser surface. -->
        <app:DitheredGradientBorder x:Name="ParserSurface"
            Style="{StaticResource OverlaySurfaceStyle}"
            Visibility="Collapsed"
            Panel.ZIndex="1">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Navigation between cover and background artwork. -->
                <StackPanel x:Name="AssetTabsPanel"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="{DynamicResource {x:Static app:UiScaleKeys.ParserTabsMargin}}">

                    <TextBlock x:Name="ParserCoversTabText"
                        Style="{StaticResource OverlayPrimaryTextStyle}"
                        FontWeight="700"
                        Margin="{DynamicResource {x:Static app:UiScaleKeys.ParserTabMargin}}"/>

                    <TextBlock x:Name="ParserBackgroundsTabText"
                        Style="{StaticResource OverlayPrimaryTextStyle}"
                        FontWeight="700"
                        Margin="{DynamicResource {x:Static app:UiScaleKeys.ParserTabMargin}}"/>

                </StackPanel>

                <!-- Divider visibility follows the asset tabs panel. -->
                <Border Grid.Row="1"
                    Style="{StaticResource AppDividerStyle}"
                    Visibility="{Binding Visibility, ElementName=AssetTabsPanel}"
                    HorizontalAlignment="Stretch"/>

                <!-- Download progress displayed over the divider area. -->
                <Grid x:Name="AssetsProgressLayer"
                    Grid.Row="1"
                    Height="{DynamicResource {x:Static app:UiScaleKeys.DividerThickness}}"
                    Visibility="{Binding Visibility, ElementName=AssetsProgressBar}"
                    HorizontalAlignment="Stretch"
                    Panel.ZIndex="10"
                    IsHitTestVisible="False">

                    <ProgressBar x:Name="AssetsProgressBar"
                        Visibility="Collapsed"
                        Opacity="0.75"
                        Minimum="0"
                        Maximum="1"
                        Height="{DynamicResource {x:Static app:UiScaleKeys.ParserProgressHeight}}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Value="0"/>

                </Grid>

                <!-- Content area shared by all parser modes. -->
                <Grid x:Name="ParserContentGrid"
                    Grid.Row="2"
                    Visibility="Collapsed"
                    Margin="0">

                    <!-- List of matching SteamGridDB games. -->
                    <ListBox x:Name="GamesListBox"
                        ItemContainerStyle="{StaticResource ParserItemStyle}"
                        Background="Transparent"
                        BorderThickness="0"
                        MaxHeight="{DynamicResource {x:Static app:UiScaleKeys.ParserGamesViewportHeight}}"
                        ScrollViewer.CanContentScroll="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Hidden"
                        VirtualizingPanel.IsVirtualizing="False">

                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <Border Margin="{DynamicResource {x:Static app:UiScaleKeys.ParserGameItemMargin}}"
                                    Padding="{DynamicResource {x:Static app:UiScaleKeys.OverlayPadding}}">

                                    <Grid VerticalAlignment="Center">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                            Text="{Binding Name}"
                                            Style="{StaticResource OverlayPrimaryTextStyle}"
                                            TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Column="1"
                                            Text="{Binding DisplayId}"
                                            Style="{StaticResource OverlaySecondaryTextStyle}"
                                            HorizontalAlignment="Right"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                    <!-- Square artwork arranged in four columns. -->
                    <ListBox x:Name="CoversListBox"
                        Visibility="Collapsed"
                        Margin="{DynamicResource {x:Static app:UiScaleKeys.ParserAssetsMargin}}"
                        ItemContainerStyle="{StaticResource ParserCoverItemStyle}"
                        Background="Transparent"
                        BorderThickness="0"
                        ScrollViewer.CanContentScroll="False"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Hidden"
                        VirtualizingPanel.IsVirtualizing="False">

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <app:ParserAssetsPanel
                                    Columns="4"
                                    Gap="{DynamicResource {x:Static app:UiScaleKeys.ParserAssetsGap}}"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <Rectangle Width="{DynamicResource {x:Static app:UiScaleKeys.ParserCoverSize}}"
                                    Height="{DynamicResource {x:Static app:UiScaleKeys.ParserCoverSize}}"
                                    RadiusX="{DynamicResource {x:Static app:UiScaleKeys.ParserMediaRadius}}"
                                    RadiusY="{DynamicResource {x:Static app:UiScaleKeys.ParserMediaRadius}}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True">

                                    <Rectangle.Fill>
                                        <ImageBrush ImageSource="{Binding ImageSource}"
                                            Stretch="UniformToFill"/>
                                    </Rectangle.Fill>

                                </Rectangle>

                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                    <!-- Wide artwork arranged in two columns. -->
                    <ListBox x:Name="BackgroundsListBox"
                        Visibility="Collapsed"
                        Margin="{DynamicResource {x:Static app:UiScaleKeys.ParserAssetsMargin}}"
                        ItemContainerStyle="{StaticResource ParserCoverItemStyle}"
                        Background="Transparent"
                        BorderThickness="0"
                        ScrollViewer.CanContentScroll="False"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Hidden"
                        VirtualizingPanel.IsVirtualizing="False">

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <app:ParserAssetsPanel
                                    Columns="2"
                                    Gap="{DynamicResource {x:Static app:UiScaleKeys.ParserAssetsGap}}"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <Rectangle Width="{DynamicResource {x:Static app:UiScaleKeys.ParserBackgroundWidth}}"
                                    Height="{DynamicResource {x:Static app:UiScaleKeys.ParserBackgroundHeight}}"
                                    RadiusX="{DynamicResource {x:Static app:UiScaleKeys.ParserMediaRadius}}"
                                    RadiusY="{DynamicResource {x:Static app:UiScaleKeys.ParserMediaRadius}}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True">

                                    <Rectangle.Fill>
                                        <ImageBrush ImageSource="{Binding ImageSource}"
                                            Stretch="UniformToFill"/>
                                    </Rectangle.Fill>

                                </Rectangle>

                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                    <!-- Text input shown when manual game search is active. -->
                    <StackPanel x:Name="ManualSearchPanel"
                        Visibility="Collapsed"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">

                        <!-- Optional hint for manual search. -->
                        <TextBlock x:Name="ManualSearchHintText"
                            Style="{StaticResource OverlaySecondaryTextStyle}"
                            Margin="{DynamicResource {x:Static app:UiScaleKeys.ParserManualSearchHintMargin}}"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"/>

                        <!-- Keep native TextBox styling and KeyDown handler. -->
                        <TextBox x:Name="SearchInputBox"
                            Height="{DynamicResource {x:Static app:UiScaleKeys.ParserInputHeight}}"
                            Margin="{DynamicResource {x:Static app:UiScaleKeys.ParserInputMargin}}"
                            HorizontalAlignment="Stretch"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            FontSize="{DynamicResource {x:Static app:UiScaleKeys.ParserInputFontSize}}"
                            MaxLength="120"
                            KeyDown="SearchInputBox_KeyDown"/>

                    </StackPanel>

                </Grid>

            </Grid>

        </app:DitheredGradientBorder>

        <!-- Backdrop behind the main parser surface. -->
        <Border x:Name="ParserBackdrop"
            Background="{DynamicResource OverlayBackdropBrush}"
            Visibility="{Binding Visibility, ElementName=ParserSurface}"
            Panel.ZIndex="0"/>

        <!-- Status message displayed above the parser surface. -->
        <app:DitheredGradientBorder x:Name="ParserStatusSurface"
            Panel.ZIndex="20"
            Visibility="Collapsed"
            MaxWidth="{DynamicResource {x:Static app:UiScaleKeys.ParserStatusSurfaceMaxWidth}}"
            Margin="{DynamicResource {x:Static app:UiScaleKeys.ParserStatusSurfaceMargin}}"
            Padding="{DynamicResource {x:Static app:UiScaleKeys.ParserStatusSurfacePadding}}"
            CornerRadius="{DynamicResource {x:Static app:UiScaleKeys.ParserStatusSurfaceRadius}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False">

            <TextBlock x:Name="StatusText"
                FontSize="{DynamicResource {x:Static app:UiScaleKeys.ParserStatusFontSize}}"
                Margin="{DynamicResource {x:Static app:UiScaleKeys.ParserStatusMargin}}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap">

                <TextBlock.RenderTransform>
                    <TranslateTransform Y="-1"/>
                </TextBlock.RenderTransform>

            </TextBlock>

        </app:DitheredGradientBorder>

    </Grid>

</UserControl>
