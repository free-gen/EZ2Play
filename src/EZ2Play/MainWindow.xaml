<ui:FluentWindow x:Class="EZ2Play.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:app="clr-namespace:EZ2Play.App"
    Title="EZ2Play Game Launcher"
    ExtendsContentIntoTitleBar="True"
    WindowState="Maximized"
    WindowStyle="None"
    Topmost="False"
    ShowInTaskbar="True"
    Cursor="None"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    Background="Transparent"
    WindowBackdropType="Mica"
    ResizeMode="NoResize"
    MinWidth="1024"
    MinHeight="576">

    <Window.Resources>
        <DropShadowEffect x:Key="TextShadowEffect"
            Color="Black"
            Opacity="0.5"
            BlurRadius="8"
            ShadowDepth="0"
            RenderingBias="Performance"/>
    </Window.Resources>
    

    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Margin="0">

        <Grid x:Name="RootGrid"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">

            <!-- Two image layers support background transitions and panning. -->
            <Grid x:Name="BackgroundViewport"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ClipToBounds="True">

                <Canvas>
                
                    <Image x:Name="BackgroundPreviousImage"
                        Stretch="Fill"
                        Opacity="0"
                        Visibility="Collapsed"
                        RenderOptions.BitmapScalingMode="HighQuality">

                        <Image.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform x:Name="BackgroundPreviousTranslate"/>
                                <TranslateTransform x:Name="BackgroundPreviousSlide"/>
                            </TransformGroup>
                        </Image.RenderTransform>

                    </Image>

                    <Image x:Name="BackgroundImage"
                        Stretch="Fill"
                        Opacity="0"
                        Visibility="Collapsed"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        CacheMode="BitmapCache">

                        <Image.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform x:Name="BackgroundTranslate"/>
                                <TranslateTransform x:Name="BackgroundSlide"/>
                            </TransformGroup>
                        </Image.RenderTransform>

                    </Image>

                </Canvas>

            </Grid>

            <!-- Particle background used when image backgrounds are unavailable. -->
            <app:ParticlesCanvas x:Name="particles" />

            <!-- Startup splash layer controlled by the splash screen manager. -->
            <Grid x:Name="SplashOverlay" Visibility="Hidden"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Background="Transparent" IsHitTestVisible="True">

                <Image x:Name="SplashLogo"
                    MaxHeight="{DynamicResource {x:Static app:UiScaleKeys.SplashLogoMaxHeight}}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Opacity="0" RenderOptions.BitmapScalingMode="HighQuality"/>

            </Grid>

            <!-- Empty-library message with separately localized text runs. -->
            <TextBlock x:Name="NoShortcutsMessage"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                TextAlignment="Center"
                Margin="{DynamicResource {x:Static app:UiScaleKeys.NoShortcutsMargin}}"
                FontSize="{DynamicResource {x:Static app:UiScaleKeys.NoShortcutsFontSize}}"
                FontWeight="300"
                Visibility="Collapsed">

                <Run x:Name="NoShortcutsMessageTop"/>
                <LineBreak/><LineBreak/>
                <Run x:Name="NoShortcutsMessageBottom"/>

            </TextBlock>

            <!-- Exit overlay shown during the application shutdown sequence. -->
            <Border x:Name="ExitOverlay" Visibility="Hidden"/>

            <TextBlock x:Name="ExitMessageText"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                FontSize="{DynamicResource {x:Static app:UiScaleKeys.ExitMessageFontSize}}"
                FontWeight="300"
                Visibility="Hidden"
                Panel.ZIndex="11">
                <Run Text="Assembled by"/>
                <Run Text="{x:Static app:AppInfo.Company}"/>
            </TextBlock>

            <!-- Hosts the settings and artwork parser overlays above the main screen. -->
            <ContentControl x:Name="OverlayHost" Panel.ZIndex="100"/>

            <!-- Main layout containing the header, carousel, game details, and hints. -->
            <Grid x:Name="MainScreenGrid" Visibility="Collapsed" Panel.ZIndex="5">
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="35*"/>
                    <RowDefinition Height="30*"/>
                    <RowDefinition Height="20*"/>
                </Grid.RowDefinitions>

                <!-- Header containing tabs, notifications, user avatar, and clock. -->
                <Grid x:Name="TopPanel" Grid.Row="0"
                    Margin="{DynamicResource {x:Static app:UiScaleKeys.TopPanelMargin}}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Background="Transparent">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="05*"/> <!-- 0 Offset -->
                        <ColumnDefinition Width="30*"/> <!-- 1 Tabs (Gamelist/LastPlayed) -->
                        <ColumnDefinition Width="50*"/> <!-- 2 NotificationPanel -->
                        <ColumnDefinition Width="05*"/> <!-- 3 UserAvatar -->
                        <ColumnDefinition Width="05*"/> <!-- 4 Time -->
                        <ColumnDefinition Width="05*"/> <!-- 5 Offset -->
                    </Grid.ColumnDefinitions>

                    <!-- Game list and Last Played tabs controlled by TabsController. -->
                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                        <TextBlock x:Name="TabGamelistText"
                            Opacity="1"
                            Effect="{StaticResource TextShadowEffect}"
                            FontSize="{DynamicResource {x:Static app:UiScaleKeys.TopInfoPrimaryFontSize}}"
                            FontWeight="900"/>
                        <TextBlock x:Name="TabLastPlayedText"
                            Margin="{DynamicResource {x:Static app:UiScaleKeys.TopInfoTabsMargin}}"
                            Opacity="0.8"
                            Effect="{StaticResource TextShadowEffect}"
                            FontSize="{DynamicResource {x:Static app:UiScaleKeys.TopInfoSecondaryFontSize}}"/>
                    </StackPanel>

                    <!-- Notification surface managed by UIRegistry. -->
                    <app:DitheredGradientBorder x:Name="NotificationPanel"
                        Grid.Column="2"
                        Visibility="Collapsed"
                        CornerRadius="{DynamicResource {x:Static app:UiScaleKeys.NotificationPanelRadius}}"
                        Height="{DynamicResource {x:Static app:UiScaleKeys.NotificationPanelHeight}}"
                        Padding="{DynamicResource {x:Static app:UiScaleKeys.NotificationPanelPadding}}"
                        Margin="{DynamicResource {x:Static app:UiScaleKeys.NotificationPanelOuterMargin}}"
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock x:Name="NotificationIcon"
                                FontSize="{DynamicResource {x:Static app:UiScaleKeys.NotificationPanelIconSize}}"
                                Margin="{DynamicResource {x:Static app:UiScaleKeys.NotificationPanelMargin}}"
                                FontFamily="{StaticResource IconFont}"/>

                            <TextBlock x:Name="NotificationText"
                                MaxWidth="{DynamicResource {x:Static app:UiScaleKeys.NotificationPanelMaxWidth}}"
                                FontSize="{DynamicResource {x:Static app:UiScaleKeys.NotificationPanelFontSize}}"
                                TextWrapping="Wrap">
                                        
                                <TextBlock.RenderTransform>
                                    <TranslateTransform Y="-2"/>
                                </TextBlock.RenderTransform>

                            </TextBlock>

                        </StackPanel>

                    </app:DitheredGradientBorder>

                    <!-- Windows account picture loaded through UIRegistry. -->
                    <Image x:Name="UserAvatar" Grid.Column="3"
                        Width="{DynamicResource {x:Static app:UiScaleKeys.UserAvatarSize}}"
                        Height="{DynamicResource {x:Static app:UiScaleKeys.UserAvatarSize}}"
                        Stretch="UniformToFill"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                    <!-- Local clock text updated by the application clock. -->
                    <TextBlock x:Name="TimeLabelText" Grid.Column="4"
                        HorizontalAlignment="Right"
                        Effect="{StaticResource TextShadowEffect}"
                        FontSize="{DynamicResource {x:Static app:UiScaleKeys.TopInfoPrimaryFontSize}}"
                        FontWeight="600"/>

                </Grid>

                <!-- Game carousel using the custom CarouselPanel and CarouselItem template. -->
                <Grid x:Name="CarouselWrapper" Grid.Row="1" ClipToBounds="True">
                    
                    <ListBox x:Name="ItemsListBox" 
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        BorderThickness="0"
                        Padding="0"
                        ClipToBounds="False"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        SelectionChanged="ItemsListBox_SelectionChanged"
                        ItemContainerStyle="{StaticResource ListBoxItemStyle}"
                        VirtualizingPanel.IsVirtualizing="False">
                        
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <app:CarouselPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <app:CarouselItem/>
                            </DataTemplate>
                        
                        </ListBox.ItemTemplate>

                    </ListBox>

                </Grid>

                <!-- Selected game title and associated metadata. -->
                <Grid Grid.Row="2">
                
                    <StackPanel Orientation="Vertical"
                        Margin="{DynamicResource {x:Static app:UiScaleKeys.GameTitleMargin}}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">

                        <TextBlock x:Name="SelectedGameTitle"
                            FontSize="{DynamicResource {x:Static app:UiScaleKeys.GameTitleFontSize}}"
                            FontWeight="500"
                            TextAlignment="Left"
                            TextWrapping="Wrap"
                            HorizontalAlignment="Stretch"
                            Effect="{StaticResource TextShadowEffect}"/>

                        <StackPanel Orientation="Horizontal" 
                            Margin="{DynamicResource {x:Static app:UiScaleKeys.SourcePillMargin}}">
                            
                            <!-- Shortcut source label bound to the current carousel selection. -->
                            <Border x:Name="GameSourcePill"
                                Style="{StaticResource LightSurfaceStyle}"
                                CornerRadius="{DynamicResource {x:Static app:UiScaleKeys.SourcePillRadius}}"
                                Width="{DynamicResource {x:Static app:UiScaleKeys.SourcePillWidth}}"
                                Height="{DynamicResource {x:Static app:UiScaleKeys.SourcePillHeight}}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left">

                                <TextBlock Text="{Binding ElementName=ItemsListBox, Path=SelectedItem.SourceType}"
                                    Foreground="{DynamicResource SolidBackgroundFillColorBaseAltBrush}"
                                    FontSize="{DynamicResource {x:Static app:UiScaleKeys.SourcePillFontSize}}"
                                    FontWeight="900"
                                    TextAlignment="Center"/>

                            </Border>

                            <!-- Game counter updated through UIRegistry. -->
                            <Border x:Name="GameCounterPill"
                                Style="{StaticResource DarkSurfaceStyle}"
                                Padding="{DynamicResource {x:Static app:UiScaleKeys.CounterPillPadding}}"
                                Margin="{DynamicResource {x:Static app:UiScaleKeys.CounterPillMargin}}"
                                Height="{DynamicResource {x:Static app:UiScaleKeys.CounterPillHeight}}"
                                CornerRadius="{DynamicResource {x:Static app:UiScaleKeys.SourcePillRadius}}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock  FontSize="{DynamicResource {x:Static app:UiScaleKeys.CounterPillIconSize}}"
                                        Margin="{DynamicResource {x:Static app:UiScaleKeys.CounterPillIconMargin}}"
                                        FontFamily="{StaticResource IconFont}">&#xE34E;</TextBlock>
                                    
                                    <TextBlock x:Name="GameCounterText"
                                        FontSize="{DynamicResource {x:Static app:UiScaleKeys.CounterPillFontSize}}"
                                        FontWeight="900"
                                        TextAlignment="Center">

                                        <TextBlock.RenderTransform>
                                            <TranslateTransform X="5" Y="-1"/>
                                        </TextBlock.RenderTransform>

                                    </TextBlock>

                                </StackPanel>

                            </Border>

                            <!-- Loading indicator controlled by application state. -->
                            <ui:ProgressRing x:Name="LoadingProgress" 
                                Margin="{DynamicResource {x:Static app:UiScaleKeys.CounterPillMargin}}"
                                Width="{DynamicResource {x:Static app:UiScaleKeys.LoadingProgressSize}}" 
                                Height="{DynamicResource {x:Static app:UiScaleKeys.LoadingProgressSize}}"
                                IsIndeterminate="True"
                                Visibility="Collapsed"/>

                        </StackPanel>

                    </StackPanel>

                </Grid>

            </Grid>

            <app:Selector x:Name="SelectionSelector"
                Panel.ZIndex="104"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False"/>

            <!-- Context-sensitive keyboard and gamepad control hints. -->
            <app:HintPanel x:Name="HintPanel"
                Grid.Row="3"
                Panel.ZIndex="105"
                Mode="Main"
                Device="Keyboard"
                Style="{StaticResource DarkSurfaceStyle}"
                Visibility="Collapsed"
                Margin="{DynamicResource {x:Static app:UiScaleKeys.HintPanelMargin}}"
                CornerRadius="{DynamicResource {x:Static app:UiScaleKeys.SourcePillRadius}}"
                Height="{DynamicResource {x:Static app:UiScaleKeys.HintPanelHeight}}"
                Padding="{DynamicResource {x:Static app:UiScaleKeys.HintPanelPadding}}" />

        </Grid>

    </Border>

</ui:FluentWindow>
