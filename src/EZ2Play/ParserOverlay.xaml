<UserControl x:Class="EZ2Play.App.ParserOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:EZ2Play.App"
             Background="Transparent">

    <UserControl.Resources>

        <Style x:Key="ParserItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="{DynamicResource {x:Static app:UiScaleKeys.ParserGameItemHeight}}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">

                        <Border x:Name="SelectionBorder"
                                Style="{StaticResource OverlaySelectionBorderStyle}"
                                Margin="{DynamicResource {x:Static app:UiScaleKeys.ParserSelectionMargin}}">

                            <Border x:Name="SelectionBackground"
                                    Style="{StaticResource OverlaySelectionBackgroundStyle}">

                                <ContentPresenter/>

                            </Border>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource OverlaySelectionBorderBrush}"/>
                                <Setter TargetName="SelectionBackground" Property="Background" Value="{DynamicResource OverlaySelectionBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ParserCoverItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">

                        <Grid HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                            <Border x:Name="SelectionBorder"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="{DynamicResource {x:Static app:UiScaleKeys.ParserMediaSelectionPadding}}"
                                    BorderThickness="{DynamicResource {x:Static app:UiScaleKeys.OverlaySelectionThickness}}"
                                    BorderBrush="Transparent"
                                    CornerRadius="{DynamicResource {x:Static app:UiScaleKeys.ParserMediaSelectionRadius}}">

                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            </Border>

                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource OverlaySelectionBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>

        <app:DitheredGradientBorder x:Name="ParserSurface"
                                    Style="{StaticResource OverlaySurfaceStyle}"
                                    Visibility="Collapsed"
                                    Panel.ZIndex="1">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

                <!-- Asset Tabs -->
                <StackPanel x:Name="AssetTabsPanel"
                            Grid.Row="0"
                            Visibility="Collapsed"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="{DynamicResource {x:Static app:UiScaleKeys.ParserTabsMargin}}">

                    <TextBlock x:Name="ParserCoversTabText"
                            Style="{StaticResource OverlayPrimaryTextStyle}"
                            FontWeight="700"
                            Margin="{DynamicResource {x:Static app:UiScaleKeys.ParserTabMargin}}"/>

                    <TextBlock x:Name="ParserBackgroundsTabText"
                            Style="{StaticResource OverlayPrimaryTextStyle}"
                            FontWeight="700"
                            Margin="{DynamicResource {x:Static app:UiScaleKeys.ParserTabMargin}}"/>

                </StackPanel>

                <!-- Asset Tabs Divider -->
                <Border Grid.Row="1"
                        Style="{StaticResource AppDividerStyle}"
                        Visibility="{Binding Visibility, ElementName=AssetTabsPanel}"
                        HorizontalAlignment="Stretch"/>

                <!-- Assets Progress Bar -->
                <Grid x:Name="AssetsProgressLayer"
                    Grid.Row="1"
                    Height="{DynamicResource {x:Static app:UiScaleKeys.DividerThickness}}"
                    Visibility="{Binding Visibility, ElementName=AssetsProgressBar}"
                    HorizontalAlignment="Stretch"
                    Panel.ZIndex="10"
                    IsHitTestVisible="False">

                    <ProgressBar x:Name="AssetsProgressBar"
                                Visibility="Collapsed"
                                Opacity="0.75"
                                Minimum="0"
                                Maximum="1"
                                Height="{DynamicResource {x:Static app:UiScaleKeys.ParserProgressHeight}}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Value="0"/>

                </Grid>

                <Grid x:Name="ParserContentGrid"
                    Grid.Row="2"
                    Visibility="Collapsed"
                    Margin="{DynamicResource {x:Static app:UiScaleKeys.OverlayPadding}}">

                    <!-- Results -->
                    <ListBox x:Name="GamesListBox"
                            ItemContainerStyle="{StaticResource ParserItemStyle}"
                            Background="Transparent"
                            BorderThickness="0"
                            MaxHeight="{DynamicResource {x:Static app:UiScaleKeys.ParserGamesViewportHeight}}"
                            ScrollViewer.CanContentScroll="True"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Hidden">

                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <TextBlock Text="{Binding DisplayText}"
                                        Style="{StaticResource OverlayPrimaryTextStyle}"
                                        Margin="{DynamicResource {x:Static app:UiScaleKeys.ParserTabMargin}}"
                                        Padding="{DynamicResource {x:Static app:UiScaleKeys.OverlayPadding}}"/>

                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                    <!-- Covers -->
                    <ListBox x:Name="CoversListBox"
                            Visibility="Collapsed"
                            Margin="{DynamicResource {x:Static app:UiScaleKeys.ParserAssetsMargin}}"
                            ItemContainerStyle="{StaticResource ParserCoverItemStyle}"
                            Background="Transparent"
                            BorderThickness="0"
                            ScrollViewer.CanContentScroll="False"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Hidden"
                            VirtualizingPanel.IsVirtualizing="False">

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <app:ParserAssetsPanel
                                    Columns="4"
                                    Gap="{DynamicResource {x:Static app:UiScaleKeys.ParserAssetsGap}}"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <Rectangle Width="{DynamicResource {x:Static app:UiScaleKeys.ParserCoverSize}}"
                                        Height="{DynamicResource {x:Static app:UiScaleKeys.ParserCoverSize}}"
                                        RadiusX="{DynamicResource {x:Static app:UiScaleKeys.ParserMediaRadius}}"
                                        RadiusY="{DynamicResource {x:Static app:UiScaleKeys.ParserMediaRadius}}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        SnapsToDevicePixels="True">

                                    <Rectangle.Fill>
                                        <ImageBrush ImageSource="{Binding ImageSource}"
                                                    Stretch="UniformToFill"/>
                                    </Rectangle.Fill>

                                </Rectangle>

                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                    <!-- Backgrounds -->
                    <ListBox x:Name="BackgroundsListBox"
                            Visibility="Collapsed"
                            Margin="{DynamicResource {x:Static app:UiScaleKeys.ParserAssetsMargin}}"
                            ItemContainerStyle="{StaticResource ParserCoverItemStyle}"
                            Background="Transparent"
                            BorderThickness="0"
                            ScrollViewer.CanContentScroll="False"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Hidden"
                            VirtualizingPanel.IsVirtualizing="False">

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <app:ParserAssetsPanel
                                    Columns="2"
                                    Gap="{DynamicResource {x:Static app:UiScaleKeys.ParserAssetsGap}}"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <Rectangle Width="{DynamicResource {x:Static app:UiScaleKeys.ParserBackgroundWidth}}"
                                        Height="{DynamicResource {x:Static app:UiScaleKeys.ParserBackgroundHeight}}"
                                        RadiusX="{DynamicResource {x:Static app:UiScaleKeys.ParserMediaRadius}}"
                                        RadiusY="{DynamicResource {x:Static app:UiScaleKeys.ParserMediaRadius}}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        SnapsToDevicePixels="True">

                                    <Rectangle.Fill>
                                        <ImageBrush ImageSource="{Binding ImageSource}"
                                                    Stretch="UniformToFill"/>
                                    </Rectangle.Fill>

                                </Rectangle>

                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                    <!-- Manual Search Panel -->
                    <StackPanel x:Name="ManualSearchPanel"
                                Visibility="Collapsed"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center">

                        <TextBlock x:Name="ManualSearchHintText"
                                    Style="{StaticResource OverlaySecondaryTextStyle}"
                                    Margin="{DynamicResource {x:Static app:UiScaleKeys.ParserManualSearchHintMargin}}"
                                    HorizontalAlignment="Center"
                                    TextAlignment="Center"/>

                        <TextBox x:Name="SearchInputBox"
                                Height="{DynamicResource {x:Static app:UiScaleKeys.ParserInputHeight}}"
                                Margin="{DynamicResource {x:Static app:UiScaleKeys.ParserInputMargin}}"
                                HorizontalAlignment="Stretch"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                FontSize="{DynamicResource {x:Static app:UiScaleKeys.ParserInputFontSize}}"
                                MaxLength="120"
                                KeyDown="SearchInputBox_KeyDown"/>

                    </StackPanel>

                </Grid>

            </Grid>

        </app:DitheredGradientBorder>

        <Border x:Name="ParserBackdrop"
                Background="{DynamicResource OverlayBackdropBrush}"
                Visibility="{Binding Visibility, ElementName=ParserSurface}"
                Panel.ZIndex="0"/>

        <!-- ParserStatusSurface -->
        <app:DitheredGradientBorder x:Name="ParserStatusSurface"
                Panel.ZIndex="20"
                Visibility="Collapsed"
                MaxWidth="{DynamicResource {x:Static app:UiScaleKeys.ParserStatusSurfaceMaxWidth}}"
                Margin="{DynamicResource {x:Static app:UiScaleKeys.ParserStatusSurfaceMargin}}"
                Padding="{DynamicResource {x:Static app:UiScaleKeys.ParserStatusSurfacePadding}}"
                CornerRadius="{DynamicResource {x:Static app:UiScaleKeys.ParserStatusSurfaceRadius}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False">

            <TextBlock x:Name="StatusText"
                    FontSize="{DynamicResource {x:Static app:UiScaleKeys.ParserStatusFontSize}}"
                    Margin="{DynamicResource {x:Static app:UiScaleKeys.ParserStatusMargin}}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap">

                <TextBlock.RenderTransform>
                    <TranslateTransform Y="-1"/>
                </TextBlock.RenderTransform>

            </TextBlock>

        </app:DitheredGradientBorder>

    </Grid>

</UserControl>