<UserControl x:Class="EZ2Play.App.ParserOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:EZ2Play.App"
             Background="{DynamicResource SmokeFillColorDefaultBrush}">

    <UserControl.Resources>

        <Style x:Key="ParserItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="{DynamicResource {x:Static app:UiScaleKeys.ParserGameItemHeight}}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">

                        <Border x:Name="SelectionBorder"
                                Margin="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlaySelectionBorderMargin}}"
                                BorderThickness="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlaySelectionBorderThickness}}"
                                BorderBrush="Transparent"
                                CornerRadius="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlaySelectionCornerRadius}}">

                            <Border x:Name="SelectionBackground"
                                    Margin="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlaySelectionBackgroundMargin}}"
                                    Background="Transparent"
                                    CornerRadius="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlaySelectionBgCornerRadius}}">

                                <ContentPresenter/>

                            </Border>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#C0FFFFFF"/>
                                <Setter TargetName="SelectionBackground" Property="Background" Value="#10FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ParserCoverItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin"
                    Value="{DynamicResource {x:Static app:UiScaleKeys.ParserCoverMargin}}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">

                        <Grid HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                            <Border x:Name="SelectionBorder"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="{DynamicResource {x:Static app:UiScaleKeys.ParserCoverMargin}}"
                                    BorderThickness="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlaySelectionBorderThickness}}"
                                    BorderBrush="Transparent"
                                    CornerRadius="{DynamicResource {x:Static app:UiScaleKeys.ParserCoverBorderRadius}}">

                                <ContentPresenter HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>

                            </Border>

                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionBorder"
                                        Property="BorderBrush"
                                        Value="#C0FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>

        <Border Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayThickness}}"
                CornerRadius="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayCornerRadius}}"
                Width="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayWidth}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayTreeItemsItemPadding}}">

            <Grid>

                    <!-- Results -->
                    <ListBox x:Name="GamesListBox"
                            ItemContainerStyle="{StaticResource ParserItemStyle}"
                            Background="Transparent"
                            BorderThickness="0"
                            MaxHeight="{DynamicResource {x:Static app:UiScaleKeys.ParserGamesViewportHeight}}"
                            ScrollViewer.CanContentScroll="True"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Hidden">

                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <TextBlock Text="{Binding DisplayText}"
                                        FontSize="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayLabelFontSize}}"
                                        Padding="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayTreeItemsItemPadding}}"/>

                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                    <!-- Covers -->
                    <ListBox x:Name="CoversListBox"
                            Visibility="Collapsed"
                            ItemContainerStyle="{StaticResource ParserCoverItemStyle}"
                            Background="Transparent"
                            BorderThickness="0"
                            MaxHeight="{DynamicResource {x:Static app:UiScaleKeys.ParserCoversViewportHeight}}"
                            ScrollViewer.CanContentScroll="False"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Hidden"
                            VirtualizingPanel.IsVirtualizing="False">

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <Rectangle Width="{DynamicResource {x:Static app:UiScaleKeys.ParserCoverSize}}"
                                        Height="{DynamicResource {x:Static app:UiScaleKeys.ParserCoverSize}}"
                                        RadiusX="{DynamicResource {x:Static app:UiScaleKeys.ParserCoverRadius}}"
                                        RadiusY="{DynamicResource {x:Static app:UiScaleKeys.ParserCoverRadius}}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        SnapsToDevicePixels="True">

                                    <Rectangle.Fill>
                                        <ImageBrush ImageSource="{Binding ImageSource}"
                                                    Stretch="UniformToFill"/>
                                    </Rectangle.Fill>

                                </Rectangle>

                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                    <!-- Status Text -->
                    <TextBlock x:Name="StatusText"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                FontSize="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayLabelTreeFontSize}}"/>

                    <!-- Manual Search Panel -->
                    <StackPanel x:Name="ManualSearchPanel"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock x:Name="ManualSearchHintText"
                                Margin="{DynamicResource {x:Static app:UiScaleKeys.ParserManualSearchHintMargin}}"
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                FontSize="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayLabelTreeFontSize}}"/>

                        <TextBox x:Name="SearchInputBox"
                                Width="{DynamicResource {x:Static app:UiScaleKeys.ParserInputWidth}}"
                                Height="{DynamicResource {x:Static app:UiScaleKeys.ParserInputHeight}}"
                                HorizontalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                FontSize="{DynamicResource {x:Static app:UiScaleKeys.ParserInputFontSize}}"
                                MaxLength="120"
                                KeyDown="SearchInputBox_KeyDown"/>

                    </StackPanel>

            </Grid>

        </Border>

        <ProgressBar x:Name="CoversProgressBar"
                    Visibility="Collapsed"
                    Minimum="0"
                    Maximum="1"
                    Width="{DynamicResource {x:Static app:UiScaleKeys.ViewportWidth}}"
                    Height="{DynamicResource {x:Static app:UiScaleKeys.ParserProgressHeight}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Value="0"/>

    </Grid>

</UserControl>