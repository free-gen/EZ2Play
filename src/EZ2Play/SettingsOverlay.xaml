<UserControl x:Class="EZ2Play.App.SettingsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:EZ2Play.App"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{DynamicResource SmokeFillColorDefaultBrush}">
    
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsItemLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin" Value="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayLabelMargin}}"/>
        </Style>

        <Style x:Key="SettingsItemDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayDescFontSize}}"/>
        </Style>

        <Style x:Key="SettingsToggleViewboxStyle" TargetType="Viewbox">
            <Setter Property="Width" Value="{DynamicResource {x:Static app:UiScaleKeys.ToggleSwitchWidth}}"/>
            <Setter Property="Height" Value="{DynamicResource {x:Static app:UiScaleKeys.ToggleSwitchHeight}}"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="SettingsTreeLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin" Value="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayLabelTreeMargin}}"/>
            <Setter Property="FontSize" Value="{DynamicResource {x:Static app:UiScaleKeys.OverlaySecondaryFontSize}}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SettingsCheckBoxViewboxStyle" TargetType="Viewbox">
            <Setter Property="Width" Value="{DynamicResource {x:Static app:UiScaleKeys.CheckBox}}"/>
            <Setter Property="Height" Value="{DynamicResource {x:Static app:UiScaleKeys.CheckBox}}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <app:DitheredGradientBorder x:Name="SettingsSurface"
                                Style="{StaticResource OverlaySurfaceStyle}"
                                Height="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="85*"/>
                <RowDefinition Height="15*"/>
            </Grid.RowDefinitions>

            <!-- ExitConfirmText -->
            <TextBlock x:Name="ExitConfirmText"
                        Grid.Row="0"
                        Visibility="Collapsed"
                        Style="{StaticResource OverlayPrimaryTextStyle}"
                        HorizontalAlignment="Center"
                        Margin="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayItemPadding}}"/>

            <ListBox x:Name="SettingsListBox"
                     Grid.Row="1"
                     FontSize="{DynamicResource {x:Static app:UiScaleKeys.OverlayPrimaryFontSize}}"
                     FontWeight="400"
                     HorizontalContentAlignment="Stretch"
                     VerticalAlignment="Center"
                     Background="Transparent">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayItemPadding}}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <!-- SelectionBorder -->
                                        <Border x:Name="SelectionBorder"
                                                Style="{StaticResource OverlaySelectionBorderStyle}">
                                            <Border x:Name="SelectionBackground"
                                                    Style="{StaticResource OverlaySelectionBackgroundStyle}"/>
                                        </Border>

                                        <!-- ItemBorder -->
                                        <Border x:Name="ItemBorder"
                                                Padding="{TemplateBinding Padding}"
                                                Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- ItemDivider -->
                                        <Border x:Name="ItemDivider"
                                                Height="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayDividerHeight}}"
                                                VerticalAlignment="Bottom"
                                                Margin="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayDividerMargin}}"
                                                Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                SnapsToDevicePixels="True"/>
                                    </Grid>

                                    <ControlTemplate.Triggers>

                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource OverlaySelectionBorderBrush}"/>
                                            <Setter TargetName="SelectionBackground" Property="Background" Value="{DynamicResource OverlaySelectionBackgroundBrush}"/>
                                        </Trigger>

                                        <!-- Gradient BG -->
                                        <Trigger Property="Tag" Value="TreeContainer">
                                            <Setter TargetName="ItemBorder" Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#00000000" Offset="0"/>
                                                        <GradientStop Color="#20000000" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="Transparent"/>
                                            <Setter TargetName="SelectionBackground" Property="Background" Value="Transparent"/>
                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <!-- SettingsAutorunApp -->
                <ListBoxItem x:Name="SettingsAutorunApp" Tag="TreeHeader">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.05*"/>
                            <ColumnDefinition Width="0.80*"/>
                            <ColumnDefinition Width="0.10*"/>
                            <ColumnDefinition Width="0.05*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayLabelMargin}}">
                            <TextBlock x:Name="SettingsAutorunAppLabel"
                                    Style="{StaticResource SettingsItemLabelStyle}"/>
                            <TextBlock x:Name="SettingsAutorunAppDesc"
                                    Style="{StaticResource SettingsItemDescriptionStyle}"/>
                        </StackPanel>

                        <Viewbox Grid.Column="2"
                                Style="{StaticResource SettingsToggleViewboxStyle}">
                            <ui:ToggleSwitch x:Name="AutorunToggle"/>
                        </Viewbox>
                    </Grid>
                </ListBoxItem>

                <!-- TreeItemsContainer -->
                <ListBoxItem x:Name="TreeItemsContainer" 
                            Background="Transparent"
                            Tag="TreeContainer" 
                            Margin="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayTreeItemsContainerMargin}}" 
                            Padding="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayTreeItemsContainerPadding}}">
                    <Grid>

                        <ListBox x:Name="SubOptionsListBox"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                Focusable="False">
                            
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" Rows="1"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <!-- Стиль для дочерних элементов (1/3 ширины) -->
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid>
                                                    <Border x:Name="SelectionBorder"
                                                            Style="{StaticResource OverlaySelectionBorderStyle}">
                                                        <Border x:Name="SelectionBackground"
                                                                Style="{StaticResource OverlaySelectionBackgroundStyle}"/>
                                                    </Border>

                                                    <!-- TreeItemStyle -->
                                                    <Border x:Name="ItemBorder"
                                                            Padding="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayTreeItemPadding}}"
                                                            Margin="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayTreeItemMargin}}"
                                                            CornerRadius="{DynamicResource {x:Static app:UiScaleKeys.OverlaySelectionBackgroundCornerRadius}}"
                                                            BorderThickness="{DynamicResource {x:Static app:UiScaleKeys.OverlayBorderThickness}}"
                                                            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </Grid>

                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource OverlaySelectionBorderBrush}"/>
                                                        <Setter TargetName="SelectionBackground" Property="Background" Value="{DynamicResource OverlaySelectionBackgroundBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <!-- NoSplash -->
                            <ListBoxItem x:Name="NoSplash" Tag="TreeItem">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.10*"/>
                                        <ColumnDefinition Width="0.80*"/>
                                        <ColumnDefinition Width="0.05*"/>
                                        <ColumnDefinition Width="0.05*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="1"
                                            x:Name="SettingsTreeNoSplash"
                                            Style="{StaticResource SettingsTreeLabelStyle}"/>

                                    <Viewbox Grid.Column="2"
                                            Style="{StaticResource SettingsCheckBoxViewboxStyle}">
                                        <CheckBox x:Name="NoSplashToggle"/>
                                    </Viewbox>
                                </Grid>
                            </ListBoxItem>

                            <!-- NoMusic -->
                            <ListBoxItem x:Name="NoMusic" Tag="TreeItem">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.10*"/>
                                        <ColumnDefinition Width="0.80*"/>
                                        <ColumnDefinition Width="0.05*"/>
                                        <ColumnDefinition Width="0.05*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="1"
                                            x:Name="SettingsTreeNoMusic"
                                            Style="{StaticResource SettingsTreeLabelStyle}"/>

                                    <Viewbox Grid.Column="2"
                                            Style="{StaticResource SettingsCheckBoxViewboxStyle}">
                                        <CheckBox x:Name="NoMusicToggle"/>
                                    </Viewbox>
                                </Grid>
                            </ListBoxItem>

                            <!-- HotSwap -->
                            <ListBoxItem x:Name="HotSwap" Tag="TreeItem">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.10*"/>
                                        <ColumnDefinition Width="0.80*"/>
                                        <ColumnDefinition Width="0.05*"/>
                                        <ColumnDefinition Width="0.05*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="1"
                                            x:Name="SettingsTreeHotSwap"
                                            Style="{StaticResource SettingsTreeLabelStyle}"/>

                                    <Viewbox Grid.Column="2"
                                            Style="{StaticResource SettingsCheckBoxViewboxStyle}">
                                        <CheckBox x:Name="HotSwapToggle"/>
                                    </Viewbox>
                                </Grid>
                            </ListBoxItem>
                        </ListBox>
                        
                    </Grid>
                </ListBoxItem>

                <!-- SettingsFpsMonitor -->
                <ListBoxItem x:Name="SettingsFpsMonitor">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.05*"/>
                            <ColumnDefinition Width="0.80*"/>
                            <ColumnDefinition Width="0.10*"/>
                            <ColumnDefinition Width="0.05*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayLabelMargin}}">
                            <TextBlock x:Name="SettingsFpsMonitorLabel"
                                    Style="{StaticResource SettingsItemLabelStyle}"/>
                            <TextBlock x:Name="SettingsFpsMonitorDesc"
                                    Style="{StaticResource SettingsItemDescriptionStyle}"/>
                        </StackPanel>

                        <Viewbox Grid.Column="2"
                                Style="{StaticResource SettingsToggleViewboxStyle}">
                            <ui:ToggleSwitch x:Name="FpsMonitorToggle"/>
                        </Viewbox>
                    </Grid>
                </ListBoxItem>

                <!-- SettingsSourceDisplay -->
                <ListBoxItem x:Name="SettingsSourceDisplay">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.05*"/>
                            <ColumnDefinition Width="0.80*"/>
                            <ColumnDefinition Width="0.10*"/>
                            <ColumnDefinition Width="0.05*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayLabelMargin}}">
                            <TextBlock x:Name="SettingsSourceDisplayLabel"
                                    Style="{StaticResource SettingsItemLabelStyle}"/>
                            <TextBlock x:Name="SettingsSourceDisplayDesc"
                                    Style="{StaticResource SettingsItemDescriptionStyle}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2" 
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Foreground="{DynamicResource ControlStrongStrokeColorDefaultBrush}" 
                        FontSize="{DynamicResource {x:Static app:UiScaleKeys.OverlaySecondaryFontSize}}"
                        FontFamily="Xbox Fluent">&#xE3B2;</TextBlock>
                    </Grid>
                </ListBoxItem>

                <!-- SettingsExitApp -->
                <ListBoxItem x:Name="SettingsExitApp" Tag="Last">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.05*"/>
                            <ColumnDefinition Width="0.90*"/>
                            <ColumnDefinition Width="0.05*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="1" 
                        x:Name="SettingsExitAppLabel" 
                        VerticalAlignment="Center"
                        Margin="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayLabelTreeMargin}}"/>
                    </Grid>
                </ListBoxItem>

            </ListBox>

            <!-- Exit Confirmation -->
            <ListBox x:Name="ExitConfirmationListBox"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    FontSize="{DynamicResource {x:Static app:UiScaleKeys.OverlayPrimaryFontSize}}"
                    FontWeight="400"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding"
                                Value="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayItemPadding}}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <Border x:Name="SelectionBorder"
                                                Style="{StaticResource OverlaySelectionBorderStyle}">
                                            <Border x:Name="SelectionBackground"
                                                    Style="{StaticResource OverlaySelectionBackgroundStyle}"/>
                                        </Border>

                                        <Border Padding="{TemplateBinding Padding}"
                                                Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource OverlaySelectionBorderBrush}"/>
                                            <Setter TargetName="SelectionBackground" Property="Background" Value="{DynamicResource OverlaySelectionBackgroundBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBoxItem x:Name="ConfirmYesItem">
                    <TextBlock x:Name="ConfirmYes"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                </ListBoxItem>

                <ListBoxItem x:Name="ConfirmNoItem">
                    <TextBlock x:Name="ConfirmNo"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                </ListBoxItem>

            </ListBox>

            <!-- AppInfo -->
            <TextBlock Grid.Row="2"
                       FontSize="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayDescFontSize}}"
                       Foreground="{DynamicResource TextFillColorDisabledBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="{DynamicResource {x:Static app:UiScaleKeys.SettingsOverlayAppInfoMargin}}">
                <Run Text="{x:Static app:AppInfo.Description}"/>
                <Run Text="v"/><Run Text="{x:Static app:AppInfo.Version}"/>
            </TextBlock>
            
        </Grid>
    </app:DitheredGradientBorder>
</UserControl>